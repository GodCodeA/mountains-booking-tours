# Public values embedded in the browser build. A Supabase publishable key is
# designed for this use; access is protected by Row Level Security policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public Turnstile site key; Vite embeds this in the booking page.
VITE_TURNSTILE_SITE_KEY=0x...

# Runtime values for server functions. Configure these as Cloudflare Worker
# variables/secrets in production, not in a committed file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Server-only Turnstile secret; never add a VITE_ prefix.
TURNSTILE_SECRET_KEY=0x...
